<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 6 to 11): nothing. The app's data holds the
     account tokens (and a stored password with its key beside it), which
     must not leave the device in a backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
